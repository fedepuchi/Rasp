# Copia a .env y ajusta. El .env esta en .gitignore y ahi se queda.
#
# DENTRO DE SIAPPC (en iot/monitor/) este archivo no hace falta: el monitor lee
# iot/.env a traves de iot/src/config.py, para que broker, credenciales y CA
# esten en un solo sitio. Esto es para correrlo suelto.

# Tiene que coincidir con `dispositivo.codigo` en la base. Si el backend no lo
# encuentra ahi, descarta las lecturas por no saber de quien son.
DEVICE_CODE=RPI-01

# El broker corre en la maquina del Compose, no en la Pi: aca va su IP o su
# nombre en la red. Solo escucha TLS, en 8883.
MQTT_HOST=192.168.0.100
MQTT_PORT=8883

# El broker no acepta conexiones anonimas.
MQTT_USER=siappc
MQTT_PASSWORD=

# CA que firma el certificado del broker. Se copia desde
# infra/mosquitto/certs/ca.crt (la genera infra/mosquitto/gen-certs.sh).
# Vacio = ./certs/ca.crt
MQTT_CA_FILE=
# Solo si el broker exige mTLS (require_certificate true).
MQTT_CLIENT_CERT_FILE=
MQTT_CLIENT_KEY_FILE=
# Escape para un broker heredado sin TLS. Dejalo en true.
MQTT_TLS=true

# Segundos entre tandas de lecturas.
PUBLISH_INTERVAL=1
# Cuantas lecturas guarda la cola local antes de tirar las mas viejas.
# 86400 es aproximadamente un dia a una por segundo.
BUFFER_MAX_ROWS=86400
